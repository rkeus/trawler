{
  "name": "trawler",
  "version": "0.1.0",
  "description": "Desktop website/template downloader that detects static vs JS-rendered sites and mirrors them locally",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/start.mjs",
    "test:electron": "npm run build:main && vitest run -c vitest.electron.config.ts",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "parse5": "^8.1.1",
    "postcss": "^8.5.33",
    "postcss-safe-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
